# --- 자격증명 / 환경 --------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# --- 도구 캐시 ---------------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
uv.lock.bak

# --- 평가 산출물 -------------------------------------------------------------
# 결과는 재현 가능해야 하므로 산출물이 아니라 러너와 데이터셋을 커밋한다.
evals/results/*
!evals/results/.gitkeep

# --- OS / 에디터 -------------------------------------------------------------
.DS_Store
.idea/
.vscode/
*.swp

# --- 0.8단계 빈도 측정 캐시 -------------------------------------------------
