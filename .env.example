# 이 파일은 "어떤 키가 필요한가"만 알린다. 실제 값을 여기에 넣지 않는다.
# 복사: cp .env.example .env  (make setup 이 자동으로 수행한다)
#
# .env 는 .gitignore 에 있다. 커밋되면 사고다.

# ---------------------------------------------------------------------------
# 실행 환경
# ---------------------------------------------------------------------------
APP_ENV=local            # local | staging | production
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# 데이터베이스
# ---------------------------------------------------------------------------
# 마이그레이션과 dispatch 워커가 쓰는 쓰기 가능 커넥션.
DATABASE_URL=postgresql://regchange:regchange_local_dev_only@localhost:5433/regchange

# LLM 이 관여하는 모든 프로세스가 쓰는 읽기 전용 커넥션 (원칙 5).
# 이 URL 에 쓰기 권한이 있는 계정을 넣지 않는다. security 테스트가 이를 검사한다.
# 0.5단계의 role 이며 app_graph 로 대체됐다. 기존 접속을 깨지 않으려 남겨 두었다.
DATABASE_URL_READONLY=postgresql://regchange_llm_ro:regchange_ro_local_dev_only@localhost:5433/regchange

# 프로세스별 role (원칙 5). 비우면 로컬 규칙으로 조립된다 — `store/dsn.py` 참조.
# 운영에서는 반드시 넣는다. 소유자 계정(DATABASE_URL)으로 애플리케이션을 돌리면
# 권한 경계가 통째로 사라지며, 그 사고는 아무 오류도 내지 않는다.
#   app_ingest   규제 테이블 INSERT. 정책/outbox 접근 불가. 마스터는 읽기만
#   app_graph    SELECT only + llm_invocation / audit_event INSERT
#   app_review   review_decision INSERT, impact_assessment.status 만 UPDATE
#   app_dispatch action_outbox SELECT/UPDATE 만. 다른 테이블은 SELECT 도 불가
DATABASE_URL_APP_INGEST=
DATABASE_URL_APP_GRAPH=
DATABASE_URL_APP_REVIEW=
DATABASE_URL_APP_DISPATCH=

# ---------------------------------------------------------------------------
# 킬 스위치 — 기본값은 전부 꺼짐 (fail-closed)
# ---------------------------------------------------------------------------
# 기본값을 꺼짐으로 두는 이유: 설정 누락이나 신규 환경 기동 시 아무것도
# 실행되지 않아야 한다. 켜져 있는 것이 기본이면 실수로 켜진 상태를 아무도
# 눈치채지 못한다. 켜는 것은 명시적 행위여야 한다.
LLM_ENABLED=false
RETRIEVAL_ENABLED=false
DISPATCH_ENABLED=false

# ---------------------------------------------------------------------------
# 법제처 Open API
# ---------------------------------------------------------------------------
# OC: 법제처 오픈API 신청 시 발급되는 사용자 식별값
LAW_GO_KR_OC=
LAW_GO_KR_BASE_URL=https://www.law.go.kr/DRF

# ---------------------------------------------------------------------------
# LLM
# ---------------------------------------------------------------------------
# 공급자와 모델은 1단계에서 평가 결과로 확정한다. 지금 값을 적으면 근거 없이
# 고정된다. TODO(verify) 상태로 둔다.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
