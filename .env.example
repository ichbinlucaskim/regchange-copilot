# 이 파일은 "어떤 키가 필요한가"만 알린다. 실제 값을 여기에 넣지 않는다.
# 복사: cp .env.example .env  (make setup 이 자동으로 수행한다)
#
# .env 는 .gitignore 에 있다. 커밋되면 사고다.

# ---------------------------------------------------------------------------
# 실행 환경
# ---------------------------------------------------------------------------
APP_ENV=local            # local | staging | production
LOG_LEVEL=INFO

# 원문 스냅샷 루트. 비우면 저장소 안 `data/snapshots` 를 쓴다.
# **운영에서는 절대 경로를 준다** — cron/launchd 는 작업 디렉터리가 다르다.
# AWS 배포에서 이 값이 S3 버킷/프리픽스가 된다. 매니페스트의 `directory` 는 이미
# 이 루트 기준 상대 경로이므로, 루트만 바꾸면 참조가 깨지지 않는다.
#
# **비워 두지 말 것.** 7일차 운영 점검에서 이 키가 `.env` 에 통째로 없었다 —
# 경고는 여기 적혀 있었고 실행이 따르지 않았다 (docs/24 §4). 지금은
# `daily_ingest.sh` 의 `cd` 와 launchd 의 `WorkingDirectory` 가 막고 있으나,
# 래퍼를 거치지 않는 호출(`regchange ops daily` 를 다른 디렉터리에서)은 막지 못한다.
#   예: SNAPSHOT_ROOT=/srv/regchange/data/snapshots
SNAPSHOT_ROOT=

# ---------------------------------------------------------------------------
# 데이터베이스
# ---------------------------------------------------------------------------
# 마이그레이션과 dispatch 워커가 쓰는 쓰기 가능 커넥션.
DATABASE_URL=postgresql://regchange:regchange_local_dev_only@localhost:5433/regchange

# LLM 이 관여하는 모든 프로세스가 쓰는 읽기 전용 커넥션 (원칙 5).
# 이 URL 에 쓰기 권한이 있는 계정을 넣지 않는다. security 테스트가 이를 검사한다.
# 0.5단계의 role 이며 app_graph 로 대체됐다. 기존 접속을 깨지 않으려 남겨 두었다.
DATABASE_URL_READONLY=postgresql://regchange_llm_ro:regchange_ro_local_dev_only@localhost:5433/regchange

# 프로세스별 role (원칙 5). 비우면 로컬 규칙으로 조립된다 — `store/dsn.py` 참조.
# 운영에서는 반드시 넣는다. 소유자 계정(DATABASE_URL)으로 애플리케이션을 돌리면
# 권한 경계가 통째로 사라지며, 그 사고는 아무 오류도 내지 않는다.
#   app_ingest   규제 테이블 INSERT. 정책/outbox 접근 불가. 마스터는 읽기만
#   app_graph    SELECT + llm_invocation / audit_event / impact_assessment INSERT.
#                graph_checkpoint 스키마의 소유자 (011). 승인 레코드는 쓸 수 없다
#   app_review   review_decision / action_outbox INSERT,
#                impact_assessment.review_state 만 UPDATE (011 이 status 에서 좁혔다)
#   app_dispatch action_outbox SELECT/UPDATE 만. 다른 테이블은 SELECT 도 불가
#   app_policy   사내 규정 코퍼스 적재. 법령 테이블에는 SELECT 도 불가 (009)
DATABASE_URL_APP_INGEST=
DATABASE_URL_APP_GRAPH=
DATABASE_URL_APP_REVIEW=
DATABASE_URL_APP_DISPATCH=
DATABASE_URL_APP_POLICY=

# ---------------------------------------------------------------------------
# 킬 스위치 — **여기 없다** (5단계, ADR-019)
# ---------------------------------------------------------------------------
# LLM_ENABLED / RETRIEVAL_ENABLED / DISPATCH_ENABLED 는 환경변수가 아니라
# DB(`kill_switch` 테이블)에 있다. 이유는 두 가지다.
#
#   1. 환경변수는 **재배포 없이 60초 내 반영**을 만족하지 못한다. 검토 UI 같은
#      장수 프로세스는 밖에서 환경변수를 바꿀 방법이 없어 "끈다"가 "재시작한다"가 된다.
#   2. 누가 언제 왜 껐는지를 남길 지점이 없다. 감사에서 "왜 그날 분석이 안 돌았나"의
#      답이 그 기록이다.
#
# 기본값은 여전히 **꺼짐**이다 — 행이 없으면 꺼진 것으로 읽는다 (fail-closed).
#
#   regchange switch list
#   regchange switch on  LLM_ENABLED --by <사람> --reason "<왜>"
#   regchange switch off LLM_ENABLED --by <사람> --reason "<왜>"
#
# **여기에 LLM_ENABLED=true 를 적어도 아무 효과가 없다.** 적지 않는 이유가 그것이다 —
# 효과 없는 설정이 파일에 있으면 그것이 켜진 상태로 읽힌다.

# ---------------------------------------------------------------------------
# 법제처 Open API
# ---------------------------------------------------------------------------
# OC: 법제처 오픈API 신청 시 발급되는 사용자 식별값
LAW_GO_KR_OC=
LAW_GO_KR_BASE_URL=https://www.law.go.kr/DRF

# ---------------------------------------------------------------------------
# LLM
# ---------------------------------------------------------------------------
# 3단계에서 확정했다 — 기본 claude-sonnet-5, 낮게 나온 케이스만 claude-opus-5 로 대조.
# 두 모델 기록이 llm_invocation 에 남아 사후 비교가 가능하다.
#
# **temperature / seed 를 두지 않는다.** 대상 모델이 샘플링 파라미터를 거부한다(400).
# 경위: docs/incidents/llm-api-schema-drift.md (미수 3).
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
# 어댑터가 호출 전에 확인하고 비어 있으면 실패한다 — 빈 키로 진행하면 실패가 인증
# 오류로 위장한다. 이름을 공급자 중립으로 두는 이유는 위 두 값과 짝을 이루기
# 때문이며, `ANTHROPIC_API_KEY` 도 대체 이름으로 받는다 (SDK 기본 이름).
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# ---------------------------------------------------------------------------
# 임베딩
# ---------------------------------------------------------------------------
# **확정: 로컬 KURE-v1** (ADR-015). 키가 필요 없다 — `uv sync --group eval` 로
# sentence-transformers 를 넣으면 된다. 로컬 모델 2종을 같은 골든셋으로 재서 골랐고,
# 규약은 docs/10-retrieval-evaluation-protocol.md (측정 **이전에** 고정한 채점 기준).
#
# 상용 API 임베딩은 **후보에서 제외했다.** 사내 규정 원문의 외부 전송이 클라우드 이용
# 심의 대상이 될 수 있어 운영에서 쓸 수 없고, 쓸 수 없는 것과 비교해 고르는 것은 선택에
# 정보를 주지 않는다. 남는 공백(상용 API 와의 품질 격차 미측정)은 ADR-015 에 명시했다.
#
# OpenAI 구현은 대조용으로 남아 있으며 채택되지 않았다. 쓰려면 이 키가 필요하다.
OPENAI_API_KEY=
